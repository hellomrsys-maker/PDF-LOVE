# Dockbench production configuration.
# Copy to .env and edit:   cp .env.example .env

# --- required for the "prod" (TLS) profile -----------------------------
# Your domain's A/AAAA record must point at this server before starting;
# Caddy then obtains and renews Let's Encrypt certificates automatically.
DOMAIN=tools.example.com
ACME_EMAIL=you@example.com

# Lock the API to your real origin (comma-separated list allowed).
ALLOWED_ORIGINS=https://tools.example.com

# --- capacity knobs (defaults are fine for a 2-4 vCPU VPS) -------------
# Upload cap per file, in MB (nginx's client_max_body_size is 60M).
MAX_FILE_MB=50
# API processes: the API only shuffles bytes in the queued topology.
WEB_WORKERS=3
# Concurrent jobs per worker container; scale containers with
# `docker compose up -d --scale worker=N` before raising this.
WORKER_MAX_JOBS=6
# Hard per-job timeout, seconds.
JOB_TIMEOUT=300

# --- observability ------------------------------------------------------
# Prometheus metrics at /api/metrics (scrape it from your monitoring box).
METRICS_ENABLED=1
# Structured JSON request logs (one JSON object per line).
LOG_JSON=1

# --- local AI (only with --profile ai) ----------------------------------
OLLAMA_MODEL=llama3.2

# --- images --------------------------------------------------------------
# Pin to a release tag for reproducible deploys, e.g. :v1.0.0
#FRONTEND_IMAGE=ghcr.io/hellomrsys-maker/dockbench-frontend:v1.0.0
#BACKEND_IMAGE=ghcr.io/hellomrsys-maker/dockbench-backend:v1.0.0

# Port for plain-HTTP local mode (ignored behind Caddy).
HTTP_PORT=8080
