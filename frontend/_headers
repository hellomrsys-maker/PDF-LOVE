# Cloudflare Workers/Pages static-asset headers — the equivalent of the
# security headers already applied by frontend/nginx.conf for the
# Docker/self-hosted deployment path. Cloudflare's static-asset serving
# never reads nginx.conf, so without this file this deployment would
# silently lose the CSP, X-Frame-Options, etc. Keep the two files' CSP
# value in sync if you edit one.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.googletagservices.com https://tpc.googlesyndication.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.google.com https://*.googlesyndication.com; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' data: blob: https://api.frankfurter.dev https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.google.com; frame-src 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://pagead2.googlesyndication.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# App shell: never cache, so updates reach users promptly (the service
# worker handles offline caching instead) — same rule as nginx.conf.
/index.html
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# CSS: cache for 30 days (may update with redesigns)
/pages.css
  Cache-Control: public, max-age=2592000

# Version-pinned static assets: cache aggressively (1 year).
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts: cache for 1 year (font URLs are content-addressed)
/vendor/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Static pages (about, faq, terms, etc.): cache for 7 days
/*.html
  Cache-Control: public, max-age=604800

/guides/*
  Cache-Control: public, max-age=604800

# Site assets: cache for 30 days
/favicon.ico
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.json
  Cache-Control: public, max-age=86400

# Compression: Cloudflare auto-enables for these types, but be explicit
# for WASM and other assets
/vendor/*.wasm
  Content-Encoding: gzip
  Cache-Control: public, max-age=31536000, immutable

/vendor/*.js
  Content-Encoding: gzip
  Cache-Control: public, max-age=31536000, immutable

/vendor/*.css
  Content-Encoding: gzip
  Cache-Control: public, max-age=31536000, immutable
