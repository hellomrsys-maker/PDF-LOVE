__pycache__/
*.pyc
*.so
.DS_Store

# Offline license signing key — secret, never commit. See licensing/README.md.
licensing/private-key.json

# wrangler (Cloudflare) local files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Compiled native extensions (built by backend/setup.py and the Dockerfile)
backend/*.so
backend/native/*.so
backend/build/

# Desktop app build output
desktop/binaries/
desktop/build/
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Android build output + staged web assets (generated by scripts/)
android/app/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/
android/app/src/main/res/mipmap-*/

# Minified build output (generated by build.mjs)
frontend/dist/

# Test fixtures and results are generated, never committed. Binaries in git
# rot: they drift from the generator that is supposed to describe them.
#   python scripts/make-fixtures.py       (PDFs, images, documents)
#   node scripts/make-media-fixture.js    (video and audio, needs a browser)
fixtures/
test-results/
