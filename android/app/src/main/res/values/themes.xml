<resources>
    <!-- Matches the web app's paper background so launch does not flash white
         before the WebView paints. -->
    <style name="Theme.Dockbench" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
    </style>
</resources>
