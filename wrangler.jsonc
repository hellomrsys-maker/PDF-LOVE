{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf-love",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "pdflove.co.in",
      "custom_domain": true
    }
  ]
}
